# Base URL for the NeXo backend API.
# Leave empty to use the same origin (the Vite dev proxy forwards /api to the
# FastAPI backend during development). In production (Vercel), set this to the
# deployed backend, e.g. https://your-backend.up.railway.app
VITE_API_URL=

# Deprecated alias for VITE_API_URL (still honored for backwards compatibility).
# VITE_API_BASE_URL=

# Backend target for the dev proxy (used only by vite.config.ts in development).
VITE_API_PROXY_TARGET=http://127.0.0.1:8002

# NeXo backend configuration (v2). Copy to .env or set in your host (Railway).

# Database. Leave unset for a local SQLite dev file; set a PostgreSQL URL in prod.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/nexo
DATABASE_URL=
# Fail fast instead of hanging startup/workers when the database is unreachable.
# NEXO_DB_CONNECT_TIMEOUT_SECONDS=10

# Auth. REQUIRED for v2 auth to mint tokens. Use a long random secret.
# NEXO_JWT_SECRET and JWT_SECRET are both accepted.
NEXO_JWT_SECRET=

# Token lifetimes (optional).
# NEXO_JWT_ACCESS_TTL_MINUTES=15
# NEXO_JWT_REFRESH_TTL_DAYS=7

# CORS: comma-separated allowlist of frontend origins (e.g. your Vercel URL).
# Never a wildcard. Empty = no cross-origin (same-origin proxy in dev).
# NEXO_CORS_ORIGINS=https://your-frontend.vercel.app

# Environment label and logging (optional).
# NEXO_ENV=production
# NEXO_LOG_LEVEL=INFO

# Port is provided by the host (Railway sets $PORT); defaults to 8080 locally.
